# ============================================================
# DeepSeek Harness — Git 忽略规则
# ============================================================

# --- 依赖与构建产物 ---
node_modules/
dist/
release/

# --- 运行数据 / 备份 / 缓存（含凭据，禁止入库）---
.dsh/
.dsh_backup/
dsh_ai_bak/
dsh_home_test/
sessions/
storages/

# --- 本地配置与敏感信息 ---
.env
settings.json
*.credentials.yaml
auth.json
*.token

# --- 内置二进制（体积大，按平台运行时提供）---
ds-harness-app/bin/
ds-harness-portable/bin/

# --- 日志 / 临时 ---
*.log
*.tmp
.DS_Store
Thumbs.db

# --- 推广素材（抖音图文/视频等，不入源码库）---
douyin-slides/
generated-videos/

# --- WorkBuddy 元数据 ---
.workbuddy/
